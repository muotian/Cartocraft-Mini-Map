{
  "pack": {
    "description": "CCMini Top Layer DP [DO NOT DISABLE]",
    "min_format": [
      94,
      1
    ],
    "max_format": 94
  },
  "filter": {
    "block": [
      {
        "namespace": "^minecraft$",
        "path": "^advancement/(?!recipes/).*"
