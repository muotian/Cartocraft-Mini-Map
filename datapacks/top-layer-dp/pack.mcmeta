      },
      {
        "namespace": "^minecraft$",
        "path": "^advancement/recipes/building_blocks/dye_\\w+_wool\\.json$"
      },
      {
        "namespace": "^minecraft$",
        "path": "^recipe/white_wool_from_string\\.json$"
      },
      {
        "namespace": "^minecraft$",
        "path": "^recipe/dye_\\w+_wool\\.json$"
      },
      {
        "namespace": "^minecraft$",
        "path": "^advancement/recipes/decorations/ender_chest\\.json$"
      },
      {
        "namespace": "^minecraft$",
        "path": "^recipe/ender_chest\\.json$"
      }
    ]
  }
}