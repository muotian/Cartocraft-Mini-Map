# 執行者是玩家
execute if score @s mini_light.lantern_energy matches 0 run title @s actionbar {"text":"Y22bbZ","font": "mini_light:weapon_actionbar","color":"#ffffff"}
execute if score @s mini_light.lantern_energy matches 1 run title @s actionbar {"text":"Y23bbZ","font": "mini_light:weapon_actionbar","color":"#ffffff"}
execute if score @s mini_light.lantern_energy matches 2.. run title @s actionbar {"text":"Y33bbZ","font": "mini_light:weapon_actionbar","color":"#ffffff"}