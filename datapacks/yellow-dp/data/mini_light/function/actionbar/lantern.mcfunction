# 執行者是玩家
execute if score @s mini_light.lantern_energy matches 0 run title @s actionbar {"text":"C000bbbD","font": "mini_light:weapon_actionbar","color":"#ffffff"}
execute if score @s mini_light.lantern_energy matches 1 run title @s actionbar {"text":"C001bbbD","font": "mini_light:weapon_actionbar","color":"#ffffff"}
execute if score @s mini_light.lantern_energy matches 2 run title @s actionbar {"text":"C011bbbD","font": "mini_light:weapon_actionbar","color":"#ffffff"}
execute if score @s mini_light.lantern_energy matches 3 run title @s actionbar {"text":"C111bbbD","font": "mini_light:weapon_actionbar","color":"#ffffff"}