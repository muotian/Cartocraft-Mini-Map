data modify storage light_green:golem_item item set from entity @s equipment.offhand
data modify storage light_green:golem_item contents set from storage light_green:golem_item item.components."minecraft:bundle_contents"[0]
data modify storage light_green:golem_item contents_id set from storage light_green:golem_item item.components."minecraft:bundle_contents"[0].id
execute store success score $golem_item light_green.main.math run data get storage light_green:golem_item item.components."minecraft:bundle_contents"[0]
execute store success score $golem_item_data light_green.main.math run data get storage light_green:golem_item contents.components."minecraft:custom_data"."light_green:golem_helmet_mod"
execute if score $golem_item light_green.main.math matches 1 if score $golem_item_data light_green.main.math matches 0 at @s anchored eyes run function light_green:item/golem/helmet/offhand/reback_item with storage light_green:golem_item
execute store success score $have_mod light_green.main.math run data get storage light_green:golem_item item.components."minecraft:bundle_contents"[0].components."minecraft:custom_data"."light_green:golem_helmet_mod"
execute if score $have_mod light_green.main.math matches 1 run data modify storage light_green:golem_item mod set from storage light_green:golem_item contents.components."minecraft:custom_data"."light_green:golem_helmet_mod"
execute if score $have_mod light_green.main.math matches 1 store success score $mod_level light_green.main.math run data get storage light_green:golem_item contents.components."minecraft:custom_data"."light_green:golem_helmet_mod_level"
execute if score $have_mod light_green.main.math matches 1 if score $mod_level light_green.main.math matches 1 store result storage light_green:golem_item level int 1 run data get storage light_green:golem_item contents.components."minecraft:custom_data"."light_green:golem_helmet_mod_level"
execute if score $have_mod light_green.main.math matches 1 if score $mod_level light_green.main.math matches 0 run data modify storage light_green:golem_item level set value ""
execute if score $have_mod light_green.main.math matches 1 run function light_green:item/golem/helmet/offhand/lore/mod with storage light_green:golem_item
execute if score $have_mod light_green.main.math matches 0 run function light_green:item/golem/helmet/offhand/lore/no_mod with storage light_green:golem_item